{
  "name": "vehicle-inventory-system",
  "version": "1.0.0",
  "description": "Vehicle Parts Inventory Management System",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently --kill-others \"npm run react-start\" \"wait-on http://localhost:3001 && npm run electron-start\"",
    "react-start": "cross-env BROWSER=none GENERATE_SOURCEMAP=false react-scripts start",
    "electron-start": "electron .",
    "dev": "npm run start",
    "build": "react-scripts build && node scripts/copy-electron.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-pack": "electron-builder --publish never",
    "electron-pack:win": "electron-builder --win --publish never",
    "electron-pack:mac": "electron-builder --mac --publish never",
    "electron-pack:linux": "electron-builder --linux",
    "dist": "npm run build && npm run electron-pack",
    "dist:all": "npm run build && npm run electron-pack -- -mwl",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w sqlite3"
  },
  "keywords": [
    "inventory",
    "management",
    "vehicle",
    "parts"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "electron-is-dev": "^2.0.0",
    "html2canvas": "^1.4.1",
    "node-notifier": "^10.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.4.3",
    "sql.js": "^1.13.0",
    "sqlite": "^5.1.1",
    "tailwindcss": "^3.2.4"
  },
  "devDependencies": {
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "react-scripts": "^0.0.0",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.autopartspro.inventory",
    "productName": "AutoParts Pro",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/src/*",
      "!**/test/*",
      "!node_modules/**/build/node_gyp_bins/**/*"
    ],
    "includeSubNodeModules": true,
    "extraMetadata": {
      "main": "build/electron/main.js"
    },
    "directories": {
      "output": "dist-production"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": false,
      "signingHashAlgorithms": []
    },
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "asar": false,
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
